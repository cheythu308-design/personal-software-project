# Example values for local development only. Never add real secrets to Git.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/document_management?createDatabaseIfNotExist=true
DB_USERNAME=dms_user
DB_PASSWORD=replace-this-local-password

# Base64-encoded secret; replace with a unique random value of at least 32 bytes.
DMS_JWT_SECRET=replace-with-a-random-base64-secret-of-at-least-32-bytes
DMS_JWT_EXPIRY_SECONDS=3600

# Optional: creates the first ADMIN account when both values are configured.
DMS_ADMIN_EMAIL=
DMS_ADMIN_PASSWORD=
DMS_ADMIN_DISPLAY_NAME=Administrator
